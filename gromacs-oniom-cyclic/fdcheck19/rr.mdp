; NVE with ONIOM, 20 ps
integrator              = md
dt                      = 0.0005
nsteps = 0
constraints             = none
cutoff-scheme           = Verlet
pbc                     = xyz
coulombtype             = PME
rcoulomb = 1.9
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
; PET-MAD interaction range is 1.5 nm: fixed pairlist reaching past it
verlet-buffer-tolerance = -1
rlist = 1.9
nstlist                 = 20
tcoupl                  = no
pcoupl                  = no
continuation            = yes
nstcalcenergy = 1
nstenergy = 1
nstlog                  = 2000
nstfout = 1
nstvout                 = 0
; ONIOM: E = E_MM(full) + E_PET-MAD(peptide) - E_MM(peptide)
metatomic-active        = yes
metatomic-model         = pet-mad-xs-v1.5.0.pt
metatomic-input-group   = Protein
metatomic-device        = cuda
metatomic-oniom         = yes
