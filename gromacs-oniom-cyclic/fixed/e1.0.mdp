; NVE with ONIOM, 20 ps
integrator              = md
dt                      = 0.0005
nsteps = 0
constraints             = none
cutoff-scheme           = Verlet
pbc                     = xyz
coulombtype             = PME
rcoulomb = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
; fixed pairlist: covers PET-MAD range (1.5 nm) and rcoulomb
verlet-buffer-tolerance = -1
rlist = 1.95
nstlist                 = 20
tcoupl                  = no
pcoupl                  = no
continuation            = yes
nstcalcenergy = 1
nstenergy               = 20
nstlog                  = 2000
nstxout-compressed      = 1000
nstvout                 = 0
; ONIOM: E = E_MM(full) + E_PET-MAD(peptide) - E_MM(peptide)
metatomic-active        = yes
metatomic-model         = pet-mad-xs-v1.5.0.pt
metatomic-input-group   = Protein
metatomic-device        = cuda
metatomic-oniom         = yes
ewald-rtol = 1e-6
fourierspacing = 0.08
