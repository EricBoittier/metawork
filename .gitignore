# Ecosystem repos cloned/managed by etc/setup-metawork.sh -- each is its own
# git checkout (with its own history/remotes), not something to embed here.
# Keep this list in sync with INSTALL_REPOS/CLONE_ONLY_REPOS in that script.
# iris-infra/ and lorem-jax/ are tracked git submodules (see .gitmodules),
# not one of these.
/metatensor/
/metatomic/
/featomic/
/metatrain/
/i-pi/
/chemiscope/
/upet/
/gpu-lite/
/hpc-docs/
/lj-test/
/lammps/
/gromacs/
/eOn/
/plumed2/
/plumed-metatomic-feedstock/
/lammps-metatomic-feedstock/

# venvs created by etc/setup-metawork.sh
/.venv/
/.venv-upet/

# datasets downloaded by etc/download-datasets.sh (when pointed inside this repo)
/data/

# isolated JAX venv for etc/lorem-parity/ (do not install JAX into .venv)
/etc/lorem-parity/.venv-jax/

# mtt train/eval artifacts when run from the repo root (see etc/lorem-parity/)
/outputs/
/model.pt
/model.ckpt
/output.xyz
/extensions/
/error.log

# per-run output dirs (manifest.yaml, job.sbatch, slurm logs) created by
# etc/hpc_run.py -- reproducibility info lives in each run's manifest.yaml,
# not in this repo; keep/archive the runs you care about elsewhere
/runs/


__pycache__/
*.pyc
