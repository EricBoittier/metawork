; ONIOM NVT, 2 ps: let the heme sites relax on the PET-MAD surface
integrator              = md
dt                      = 0.0005
constraints             = none          ; ML atoms are flexible, waters stay rigid via SETTLE
cutoff-scheme           = Verlet
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
DispCorr                = no
verlet-buffer-tolerance = -1
rlist                   = 1.3           ; >= rcoulomb; the ML pairs only need the 0.8 nm NL cutoff + buffer
nstlist                 = 20
nstcalcenergy           = 1
nstenergy               = 20
nstlog                  = 1000
nstxout-compressed      = 1000
nsteps                  = 4000
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 300
continuation            = yes
; ONIOM: PET-MAD on the four heme sites (group ML), CHARMM27 elsewhere
metatomic-active        = yes
metatomic-model         = @MODELS@/pet-omol-s-v1.0.0.pt
metatomic-input-group   = ML
metatomic-device        = cuda
metatomic-oniom         = yes
metatomic-link-atoms    = yes          ; cap the four CA-CB cuts with hydrogens
; four separate ML systems: each heme (-2, two propionates) with its proximal His side chain,
; high-spin Fe(II) (quintet) as in deoxy hemoglobin
metatomic-site-groups   = SITE1 SITE2 SITE3 SITE4
metatomic-site-charges  = -2
metatomic-site-spin-multiplicities = 5
