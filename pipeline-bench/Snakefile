rule resume_cell:
    input:
        marker=WORKTREES / "{variant}" / ".variant-shas",
        dataset=dataset_input,
    output:
        json=RESULTS / "resume_cells" / "{variant}" / "{dataset}" / "w{workers}.json",
        log=RESULTS / "resume_cells" / "{variant}" / "{dataset}" / "w{workers}.log",
    params:
        worktree=lambda wildcards: WORKTREES / wildcards.variant,
        key=lambda wildcards: DATASETS[wildcards.dataset]["key"],
        batch=RESUME_BATCH,
        device=RESUME_DEVICE,
        epochs=RESUME_EPOCHS,
        split=RESUME_SPLIT,
        seed=RESUME_SEED,
        timeout=RESUME_TIMEOUT,
        python=SNAKEMAKE_PY,
    resources:
        gpu=RESOURCES.get("gpus", 1),
        mem_mb=RESOURCES.get("mem_mb", 16000),
        runtime=RESOURCES.get("runtime_min", 90),
    shell:
        "{params.python} {SCRIPTS}/run_resume_check.py "
        "--worktree {params.worktree} "
        "--python {PYTHON} "
        "--dataset {input.dataset} "
        "--key {params.key} "
        "--num-workers {wildcards.workers} "
        "--batch-size {params.batch} "
        "--device {params.device} "
        "--epochs {params.epochs} "
        "--split-epoch {params.split} "
        "--seed {params.seed} "
        "--timeout-s {params.timeout} "
        "--variant {wildcards.variant} "
        "--dataset-name {wildcards.dataset} "
        "--out {output.json} "
        "--log {output.log}"


rule check_resume:
    input:
        RESUME_CELLS,
    output:
        RESULTS / "resume.md",
    params:
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/check_resume.py {input} --out {output}"
