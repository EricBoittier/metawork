from pathlib import Path
import re
import sys

import yaml

configfile: "config.yaml"

HERE = Path(workflow.basedir)
SCRIPTS = HERE / "scripts"
SNAKEMAKE_PY = sys.executable
FILE_CFG = yaml.safe_load((HERE / "config.yaml").read_text())


def active_config():
    """Apply the `smoke:` block when `--config smoke=true` or `run=smoke`.

    `--config smoke=true` overwrites the YAML mapping, so the block is read
    from the file rather than from `config`.
    """
    cfg = dict(config)
    flag = cfg.get("smoke")
    run = str(cfg.get("run", "")).lower()
    want_smoke = run == "smoke" or flag is True or str(flag).lower() in (
        "true",
        "1",
        "yes",
    )
    if not want_smoke:
        return cfg
    block = FILE_CFG.get("smoke") or {}
    cfg["variants"] = {name: cfg["variants"][name] for name in block["variants"]}
    cfg["datasets"] = {name: cfg["datasets"][name] for name in block["datasets"]}
    sweep = dict(cfg["sweep"])
    for key in ("workers", "batch_size", "device", "epochs", "repeats", "timeout_s"):
        if key in block:
            sweep[key] = block[key]
    cfg["sweep"] = sweep
    return cfg


CFG = active_config()
RESULTS = HERE / CFG.get("results", "results")
WORKTREES = HERE / CFG.get("worktrees", "worktrees")
DATA = HERE / CFG.get("data", "data")
PYTHON = CFG["python"]
REPO = Path(CFG["metatrain"])
VARIANTS = CFG["variants"]
DATASETS = CFG["datasets"]
# A dataset with `matrix: false` (e.g. a distributed-only large proxy) is
# resolvable by name for the `distributed` sweep but excluded from the main
# variant x dataset x workers cross product -- without this, adding one
# large-scale dataset for a distributed-only sweep would silently also
# multiply out 6 variants x 3 worker counts x repeats of it in `rule all`.
MATRIX_DATASETS = {k: v for k, v in DATASETS.items() if v.get("matrix", True)}
SWEEP = CFG["sweep"]
WORKERS = [str(w) for w in SWEEP["workers"]]
BATCHES = [str(b) for b in SWEEP["batch_size"]]
REPEATS = [str(r) for r in range(int(SWEEP["repeats"]))]
DEVICE = str(SWEEP["device"])
EPOCHS = int(SWEEP["epochs"])
TIMEOUT = int(SWEEP.get("timeout_s", 3600))
RESOURCES = CFG.get("resources", {})

DIST = CFG.get("distributed", {})
DIST_VARIANTS = list(DIST.get("variants", []))
DIST_DATASET = DIST.get("dataset")
DIST_WORLD_SIZES = [str(w) for w in DIST.get("world_sizes", [1])]
DIST_REPEATS = [str(r) for r in range(int(DIST.get("repeats", 1)))]
# `datasets:` is trimmed down by active_config() when smoke=true, but the
# `distributed:` sweep is independent of smoke -- resolve its dataset from
# the untrimmed file config instead of the (possibly smoke-filtered) DATASETS.
ALL_DATASETS = FILE_CFG.get("datasets", {})


def resolve_dataset(name, datasets=None):
    path = Path((datasets or DATASETS)[name]["path"])
    return path if path.is_absolute() else HERE / path


CELLS = [
    RESULTS
    / "cells"
    / variant
    / dataset
    / f"w{workers}_b{batch}_{DEVICE}_r{repeat}.json"
    for variant in VARIANTS
    for dataset in MATRIX_DATASETS
    for workers in WORKERS
    for batch in BATCHES
    for repeat in REPEATS
]

DIST_CELLS = [
    RESULTS / "distributed" / variant / f"g{world_size}_r{repeat}.json"
    for variant in DIST_VARIANTS
    for world_size in DIST_WORLD_SIZES
    for repeat in DIST_REPEATS
]

wildcard_constraints:
    variant="|".join(map(re.escape, VARIANTS)),
    dataset="|".join(map(re.escape, MATRIX_DATASETS)),
    workers="[0-9]+",
    batch="[0-9]+",
    repeat="[0-9]+",
    device="cpu|cuda",
    world_size="[0-9]+",


rule all:
    input:
        RESULTS / "summary.md",
        RESULTS / "cells.csv",
        RESULTS / "stages.csv",


rule si_bulk:
    output:
        DATA / "si_bulk_216.xyz",
    params:
        n_cells=DATASETS.get("si216", {}).get("generate", {}).get("n_cells", 3),
        n_structures=DATASETS.get("si216", {}).get("generate", {}).get("n_structures", 64),
        seed=DATASETS.get("si216", {}).get("generate", {}).get("seed", 0),
    shell:
        "{PYTHON} {SCRIPTS}/make_si_bulk.py --out {output} "
        "--n-cells {params.n_cells} --n-structures {params.n_structures} "
        "--seed {params.seed}"


rule omol_proxy:
    output:
        DATA / "omol_proxy.xyz",
    params:
        n_structures=DATASETS.get("omol_proxy", {}).get("generate", {}).get("n_structures", 200),
        max_cells=DATASETS.get("omol_proxy", {}).get("generate", {}).get("max_cells", 4),
        seed=DATASETS.get("omol_proxy", {}).get("generate", {}).get("seed", 0),
    shell:
        "{PYTHON} {SCRIPTS}/make_omol_proxy.py --out {output} "
        "--n-structures {params.n_structures} --max-cells {params.max_cells} "
        "--seed {params.seed}"


rule omol_large:
    output:
        DATA / "omol_large.xyz",
    params:
        n_structures=DATASETS.get("omol_large", {}).get("generate", {}).get("n_structures", 400),
        max_cells=DATASETS.get("omol_large", {}).get("generate", {}).get("max_cells", 6),
        seed=DATASETS.get("omol_large", {}).get("generate", {}).get("seed", 1),
    shell:
        "{PYTHON} {SCRIPTS}/make_omol_proxy.py --out {output} "
        "--n-structures {params.n_structures} --max-cells {params.max_cells} "
        "--seed {params.seed}"


rule omol_billion_proxy:
    output:
        DATA / "omol_billion_proxy.xyz",
    params:
        n_structures=ALL_DATASETS.get("omol_billion_proxy", {}).get("generate", {}).get("n_structures", 3000),
        max_cells=ALL_DATASETS.get("omol_billion_proxy", {}).get("generate", {}).get("max_cells", 8),
        seed=ALL_DATASETS.get("omol_billion_proxy", {}).get("generate", {}).get("seed", 2),
    shell:
        "{PYTHON} {SCRIPTS}/make_omol_proxy.py --out {output} "
        "--n-structures {params.n_structures} --max-cells {params.max_cells} "
        "--seed {params.seed}"


def dataset_input(wildcards):
    return resolve_dataset(wildcards.dataset)


rule worktree:
    output:
        marker=WORKTREES / "{variant}" / ".variant-shas",
    params:
        refs=lambda wildcards: VARIANTS[wildcards.variant]["refs"],
        path=lambda wildcards: WORKTREES / wildcards.variant,
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/make_worktree.py "
        "--repo {REPO} --path {params.path} --refs {params.refs}"


rule cell:
    input:
        marker=WORKTREES / "{variant}" / ".variant-shas",
        dataset=dataset_input,
    output:
        json=RESULTS
        / "cells"
        / "{variant}"
        / "{dataset}"
        / "w{workers}_b{batch}_{device}_r{repeat}.json",
        log=RESULTS
        / "cells"
        / "{variant}"
        / "{dataset}"
        / "w{workers}_b{batch}_{device}_r{repeat}.log",
    params:
        worktree=lambda wildcards: WORKTREES / wildcards.variant,
        key=lambda wildcards: DATASETS[wildcards.dataset]["key"],
        epochs=EPOCHS,
        timeout=TIMEOUT,
        python=SNAKEMAKE_PY,
    resources:
        gpu=RESOURCES.get("gpus", 1),
        mem_mb=RESOURCES.get("mem_mb", 16000),
        runtime=RESOURCES.get("runtime_min", 90),
    shell:
        "{params.python} {SCRIPTS}/run_cell.py "
        "--worktree {params.worktree} "
        "--python {PYTHON} "
        "--dataset {input.dataset} "
        "--key {params.key} "
        "--num-workers {wildcards.workers} "
        "--batch-size {wildcards.batch} "
        "--device {wildcards.device} "
        "--epochs {params.epochs} "
        "--timeout-s {params.timeout} "
        "--variant {wildcards.variant} "
        "--dataset-name {wildcards.dataset} "
        "--repeat {wildcards.repeat} "
        "--out {output.json} "
        "--log {output.log}"


rule distributed_cell:
    input:
        marker=WORKTREES / "{variant}" / ".variant-shas",
        dataset=resolve_dataset(DIST_DATASET, ALL_DATASETS) if DIST_DATASET else [],
    output:
        json=RESULTS / "distributed" / "{variant}" / "g{world_size}_r{repeat}.json",
        log=RESULTS / "distributed" / "{variant}" / "g{world_size}_r{repeat}.log",
    params:
        worktree=lambda wildcards: WORKTREES / wildcards.variant,
        key=ALL_DATASETS.get(DIST_DATASET, {}).get("key", "energy"),
        epochs=DIST.get("epochs", 2),
        timeout=DIST.get("timeout_s", 1500),
        batch_size=DIST.get("batch_size", 8),
        # baseline (origin/perf/1-pipeline-benchmark, the earliest branch in
        # the stack) predates the --max-atoms-per-batch CLI flag entirely --
        # atom-count batching is one of the later perf/pr additions, not
        # just a benchmark-harness convenience. Passing it unconditionally
        # would break baseline outright, so it's opt-in per config and
        # dropped (fixed batch_size for every variant) for a fair
        # cross-variant DDP scaling comparison.
        max_atoms_flag=(
            f"--max-atoms-per-batch {DIST['max_atoms_per_batch']}"
            if DIST.get("max_atoms_per_batch")
            else ""
        ),
        python=SNAKEMAKE_PY,
    resources:
        gpu=lambda wildcards: int(wildcards.world_size),
        mem_mb=DIST.get("mem_mb", 32000),
        runtime=DIST.get("runtime_min", 30),
    shell:
        "{params.python} {SCRIPTS}/run_cell.py "
        "--worktree {params.worktree} "
        "--python {PYTHON} "
        "--dataset {input.dataset} "
        "--key {params.key} "
        "--num-workers 0 "
        "--batch-size {params.batch_size} "
        "--device cuda "
        "--epochs {params.epochs} "
        "--timeout-s {params.timeout} "
        "--variant {wildcards.variant} "
        "--dataset-name {DIST_DATASET} "
        "--repeat {wildcards.repeat} "
        "--world-size {wildcards.world_size} "
        "{params.max_atoms_flag} "
        "--out {output.json} "
        "--log {output.log}"


rule distributed_aggregate:
    input:
        DIST_CELLS,
    output:
        summary=RESULTS / "distributed_summary.md",
        cells=RESULTS / "distributed_cells.csv",
        stages=RESULTS / "distributed_stages.csv",
    params:
        baseline=CFG.get("baseline_variant", "baseline"),
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/aggregate.py {input} "
        "--baseline {params.baseline} "
        "--cells-csv {output.cells} "
        "--stages-csv {output.stages} "
        "--summary {output.summary}"


rule distributed:
    input:
        RESULTS / "distributed_summary.md",
        RESULTS / "distributed_cells.csv",
        RESULTS / "distributed_stages.csv",


rule aggregate:
    input:
        CELLS,
    output:
        summary=RESULTS / "summary.md",
        cells=RESULTS / "cells.csv",
        stages=RESULTS / "stages.csv",
    params:
        baseline=CFG.get("baseline_variant", "baseline"),
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/aggregate.py {input} "
        "--baseline {params.baseline} "
        "--cells-csv {output.cells} "
        "--stages-csv {output.stages} "
        "--summary {output.summary}"
