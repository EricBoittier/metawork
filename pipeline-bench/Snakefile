rule check_correctness:
    input:
        RESULTS / "cells.csv",
    output:
        RESULTS / "correctness.md",
    params:
        python=SNAKEMAKE_PY,
        baseline=CFG.get("baseline_variant", "baseline"),
    shell:
        "{params.python} {SCRIPTS}/check_correctness.py "
