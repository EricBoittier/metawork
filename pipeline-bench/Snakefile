from pathlib import Path
import re
import sys

import yaml

configfile: "config.yaml"

HERE = Path(workflow.basedir)
SCRIPTS = HERE / "scripts"
SNAKEMAKE_PY = sys.executable
FILE_CFG = yaml.safe_load((HERE / "config.yaml").read_text())


def apply_override(cfg, block):
    cfg["variants"] = {name: cfg["variants"][name] for name in block["variants"]}
    cfg["datasets"] = {name: cfg["datasets"][name] for name in block["datasets"]}
    sweep = dict(cfg["sweep"])
    for key in (
        "workers",
        "batch_size",
        "device",
        "epochs",
        "repeats",
        "seeds",
        "timeout_s",
    ):
        if key in block:
            sweep[key] = block[key]
    cfg["sweep"] = sweep
    return cfg


def active_config():
    """Apply the `smoke:` or `correctness:` block by name.

    `--config smoke=true` / `--config correctness=true` (or `run=smoke` /
    `run=correctness`) overwrite the YAML mapping, so the block is read from
    the file rather than from `config`. `correctness` is small and
    multi-seed on purpose — see the block's own comment in config.yaml.
    """
    cfg = dict(config)
    run = str(cfg.get("run", "")).lower()

    def wants(name):
        flag = cfg.get(name)
        return run == name or flag is True or str(flag).lower() in (
            "true",
            "1",
            "yes",
        )

    for name in ("smoke", "correctness"):
        if wants(name):
            return apply_override(cfg, FILE_CFG.get(name) or {})
    return cfg


CFG = active_config()
RESULTS = HERE / CFG.get("results", "results")
WORKTREES = HERE / CFG.get("worktrees", "worktrees")
DATA = HERE / CFG.get("data", "data")
PYTHON = CFG["python"]
REPO = Path(CFG["metatrain"])
VARIANTS = CFG["variants"]
DATASETS = CFG["datasets"]
SWEEP = CFG["sweep"]
WORKERS = [str(w) for w in SWEEP["workers"]]
BATCHES = [str(b) for b in SWEEP["batch_size"]]
REPEATS = [str(r) for r in range(int(SWEEP["repeats"]))]
DEVICE = str(SWEEP["device"])
EPOCHS = str(SWEEP["epochs"])
SEEDS = [str(s) for s in SWEEP.get("seeds", [0])]
TIMEOUT = int(SWEEP.get("timeout_s", 3600))
RESOURCES = CFG.get("resources", {})

RESUME_CFG = CFG.get("resume_check", {})
RESUME_DATASETS = [d for d in RESUME_CFG.get("datasets", ["qm9"]) if d in DATASETS]
RESUME_WORKERS = [str(w) for w in RESUME_CFG.get("workers", [0, 1])]
RESUME_BATCH = int(RESUME_CFG.get("batch_size", 8))
RESUME_DEVICE = str(RESUME_CFG.get("device", "cuda"))
RESUME_EPOCHS = int(RESUME_CFG.get("epochs", 6))
RESUME_SPLIT = int(RESUME_CFG.get("split_epoch", 3))
RESUME_SEED = int(RESUME_CFG.get("seed", 0))
RESUME_TIMEOUT = int(RESUME_CFG.get("timeout_s", 1200))

RESUME_CELLS = [
    RESULTS / "resume_cells" / variant / dataset / f"w{workers}.json"
    for variant in VARIANTS
    for dataset in RESUME_DATASETS
    for workers in RESUME_WORKERS
]


def resolve_dataset(name):
    path = Path(DATASETS[name]["path"])
    return path if path.is_absolute() else HERE / path


CELLS = [
    RESULTS
    / "cells"
    / variant
    / dataset
    / f"w{workers}_b{batch}_{DEVICE}_r{repeat}_s{seed}_e{EPOCHS}.json"
    for variant in VARIANTS
    for dataset in DATASETS
    for workers in WORKERS
    for batch in BATCHES
    for repeat in REPEATS
    for seed in SEEDS
]

wildcard_constraints:
    variant="|".join(map(re.escape, VARIANTS)),
    dataset="|".join(map(re.escape, DATASETS)),
    workers="[0-9]+",
    batch="[0-9]+",
    repeat="[0-9]+",
    seed="[0-9]+",
    epochs="[0-9]+",
    device="cpu|cuda",


rule all:
    input:
        RESULTS / "summary.md",
        RESULTS / "cells.csv",
        RESULTS / "stages.csv",
        RESULTS / "equivalence.md",
        RESULTS / "drift.md",
        RESULTS / "correctness.md",
        RESULTS / "resume.md",


rule si_bulk:
    output:
        DATA / "si_bulk_216.xyz",
    params:
        n_cells=DATASETS.get("si216", {}).get("generate", {}).get("n_cells", 3),
        n_structures=DATASETS.get("si216", {}).get("generate", {}).get("n_structures", 64),
        seed=DATASETS.get("si216", {}).get("generate", {}).get("seed", 0),
    shell:
        "{PYTHON} {SCRIPTS}/make_si_bulk.py --out {output} "
        "--n-cells {params.n_cells} --n-structures {params.n_structures} "
        "--seed {params.seed}"


def dataset_input(wildcards):
    return resolve_dataset(wildcards.dataset)


rule worktree:
    output:
        marker=WORKTREES / "{variant}" / ".variant-shas",
    params:
        refs=lambda wildcards: VARIANTS[wildcards.variant]["refs"],
        path=lambda wildcards: WORKTREES / wildcards.variant,
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/make_worktree.py "
        "--repo {REPO} --path {params.path} --refs {params.refs}"


rule cell:
    input:
        marker=WORKTREES / "{variant}" / ".variant-shas",
        dataset=dataset_input,
    output:
        json=RESULTS
        / "cells"
        / "{variant}"
        / "{dataset}"
        / "w{workers}_b{batch}_{device}_r{repeat}_s{seed}_e{epochs}.json",
        log=RESULTS
        / "cells"
        / "{variant}"
        / "{dataset}"
        / "w{workers}_b{batch}_{device}_r{repeat}_s{seed}_e{epochs}.log",
    params:
        worktree=lambda wildcards: WORKTREES / wildcards.variant,
        key=lambda wildcards: DATASETS[wildcards.dataset]["key"],
        timeout=TIMEOUT,
        python=SNAKEMAKE_PY,
    resources:
        gpu=RESOURCES.get("gpus", 1),
        mem_mb=RESOURCES.get("mem_mb", 16000),
        runtime=RESOURCES.get("runtime_min", 90),
    shell:
        "{params.python} {SCRIPTS}/run_cell.py "
        "--worktree {params.worktree} "
        "--python {PYTHON} "
        "--dataset {input.dataset} "
        "--key {params.key} "
        "--num-workers {wildcards.workers} "
        "--batch-size {wildcards.batch} "
        "--device {wildcards.device} "
        "--epochs {wildcards.epochs} "
        "--seed {wildcards.seed} "
        "--timeout-s {params.timeout} "
        "--variant {wildcards.variant} "
        "--dataset-name {wildcards.dataset} "
        "--repeat {wildcards.repeat} "
        "--out {output.json} "
        "--log {output.log}"


rule aggregate:
    input:
        CELLS,
    output:
        summary=RESULTS / "summary.md",
        cells=RESULTS / "cells.csv",
        stages=RESULTS / "stages.csv",
    params:
        baseline=CFG.get("baseline_variant", "baseline"),
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/aggregate.py {input} "
        "--baseline {params.baseline} "
        "--cells-csv {output.cells} "
        "--stages-csv {output.stages} "
        "--summary {output.summary}"


rule check_equivalence:
    input:
        RESULTS / "cells.csv",
    output:
        RESULTS / "equivalence.md",
    params:
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/check_equivalence.py "
        "--cells-csv {input} --out {output}"


rule check_drift:
    input:
        RESULTS / "cells.csv",
    output:
        RESULTS / "drift.md",
    params:
        python=SNAKEMAKE_PY,
    shell:
        "{params.python} {SCRIPTS}/check_drift.py "
